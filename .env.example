# Copy to .env (or set in your hosting provider) and fill in confirmed values only.
# Anything left blank is simply not shown on the site.

# Public URL of the site, without a trailing slash. Enables canonical URLs,
# og:url, structured data and sitemap.xml. Example: https://www.your-domain.in
VITE_SITE_URL=

# --- Enquiry form ---------------------------------------------------------
# Endpoint that receives the enquiry as a JSON POST. Works with:
#   - Formspree:  https://formspree.io/f/<form-id>
#   - Web3Forms:  https://api.web3forms.com/submit   (also set VITE_ENQUIRY_ACCESS_KEY)
#   - Your own API / serverless function returning 2xx on success
# While empty, the form explains that online enquiries are not yet connected
# and never reports a successful delivery.
VITE_ENQUIRY_ENDPOINT=

# Optional public access key sent as "access_key" (required by Web3Forms).
VITE_ENQUIRY_ACCESS_KEY=

# Optional Cloudflare Turnstile site key for spam protection. The token is sent
# as "cf-turnstile-response"; verify it server-side with your secret key.
VITE_TURNSTILE_SITE_KEY=

# --- Direct contact details (leave blank until confirmed) -----------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
